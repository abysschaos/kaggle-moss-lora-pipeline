# ==============================================================================
# OpenMOSS MOSS-Image Dual-Track LoRA Pipeline - 环境变量参考模板 (脱敏)
# ==============================================================================
# 说明：
#   1. 本文件仅作参考与按需导出使用；严禁将包含真实密钥或私有路径的 .env 提交到仓库。
#   2. 本地训练参数也可直接通过 GUI (MOSS_LoRA_Trainer.exe) 或 train_local.py CLI 传递；
#      云端脚本 train_moss.py 支持通过以下环境变量或 CLI 参数控制。

# ------------------------------------------------------------------------------
# 一、Windows 本地运行环境指针 (可选，不配置时会自动全盘探测)
# ------------------------------------------------------------------------------
# 显式指定具备 CUDA PyTorch 的 ComfyUI 便携版 / 独立 Python 路径
# COMFYUI_PYTHON=D:\ComfyUI_windows_portable\python_embeded\python.exe

# 显式指定本地 ComfyUI 安装根目录或 models 目录（也支持 COMFY_PATH / COMFYUI_MODELS）
# COMFYUI_PATH=D:\ComfyUI_windows_portable\ComfyUI
# COMFYUI_MODELS=D:\ComfyUI_windows_portable\ComfyUI\models

# 内部暂停信号文件路径（通常由 gui_local.py 自动生成与清理，一般无需手动设置）
# KOHAKUMOSS_PAUSE_FILE=

# ------------------------------------------------------------------------------
# 二、HuggingFace / GitHub 访问令牌 (可选)
# ------------------------------------------------------------------------------
# 若需在受限网络或云端加速拉取底模，可填入只读 HF Token（切勿提交真实令牌）
# HF_TOKEN=
# 若需自定义 Cloudflare R2 凭据 JSON 路径（默认 ~/.kaggle/r2_credentials.json），可覆盖此路径
# R2_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 三、云端引擎 (train_moss.py) 全量可配置环境变量 (与 CLI 参数 1:1 等价)
# ------------------------------------------------------------------------------
# 基础标识与触发词
LORA_NAME=my_lora
TRIGGER_WORD=

# 步数与样本重复配置
REPEATS=10
EPOCHS=6
STEPS=600

# 适配器结构与高阶参数
RANK=32
ALPHA=32.0
# 可选值: lora | loha | lokr
ALGO=lora
# LoKr 专属参数 (仅 ALGO=lokr 生效): 因子 (-1/4/8/16), 是否启用 FullMatrix / DecomposeBoth
LOKR_FACTOR=8
LOKR_FULL_MATRIX=false
LOKR_DECOMPOSE_BOTH=false
# 是否同时训练 AdaLN/RMS/LayerNorm 归一化权重
TRAIN_NORMS=false
# 三层防过拟合 Dropout ([0.0, 1.0); 启用 USE_DORA=true 时 INPUT_DROPOUT 自动强制锁定 0.0)
INPUT_DROPOUT=0.0
RANK_DROPOUT=0.0
MODULE_DROPOUT=0.0
# 可选值: false | true
USE_DORA=false
# 可选值: attn | attn-mlp | attn-mlp+modulation | attn-mlp+text-refiner | full-block | all
TARGET_PRESET=attn-mlp
# LoRA+ 上投影学习率倍率 (1.0=关闭, 多概念推荐 2.0~4.0)
LORAPLUS_RATIO=1.0
# 优化器与学习率调度控制
# 优化器可选: adamw | adamw8bit_kernel | muon (非 adamw 自动切换 GPU 优化器安全显存档位)
OPTIMIZER=adamw
# 学习率调度: cosine | constant
LR_SCHEDULER=cosine
# 预热步数 (-1=自动按总步数 5% 计算并裁剪在 [5, 100]; >=0 显式指定)
WARMUP_STEPS=-1
WEIGHT_DECAY=0.01
# 权重衰减规则: moss | none | all
WD_RULES=moss
# EMA 指数滑动平均衰减率 (0.0=关闭; 长步数或高学习率平滑推荐 0.99~0.995)
EMA=0.0
# 梯度累积步数与时间步采样控制 (画风推荐 GRAD_ACC=1, TIMESTEP_MU=-1.09；角色细节推荐 GRAD_ACC=2, TIMESTEP_MU=0.35)
GRAD_ACC=1
# 时间步采样分布: moss | uniform | logit_normal (注: logit_normal 的 Mu 正负号与 moss 相反)
TIMESTEP=moss
TIMESTEP_MU=-1.09
# 数据增强与复现/导出控制
TEXT_DROP=0.05
# 水平镜像翻转 (人物不对称服饰/文字排版严禁开启!)
FLIP=false
SEED=0
# 导出格式: both | comfy | lycoris
SAVE_FORMAT=both
# 多子集配比 JSON 文件路径或 JSON 数组字符串 (留空则使用单图集)
SUBSETS_JSON=
LR=1e-4

# 底模变体与硬件自适应配置
# 可选值: heal | base | sft (对应参数 --variant)
MODEL_VARIANT=heal
# 可选值: auto | 6g | 8g | 12g | 16g
VRAM_PRESET=auto
# 可选值: 1024 | 896 | 768 | 512
RESOLUTION=1024
# 可选值: auto | int8 | full
BASE_QUANT=auto
# 可选值: auto | int8 | fp8 | fp8_compute | compute (fp8/fp8_compute 仅限 RTX 40系 / L4 / A100 等 sm89+ 架构且非 int8_convrot 底模)
BASE_PRECISION=auto
# 可选值: auto | fp16 | bf16
PRECISION=auto
# 可选值: off | table (table 首次编译耗时较长，可提速后续稳态 step)
TUNE=off
# 超长图文截断保护策略: drop_tokens (默认仅截断超限文本保留图片) | drop (整条样本丢弃)
OVERLONG=drop_tokens
# 可选值: auto | cuda | cpu
TEXT_DEVICE=auto
# 可选值: cuda | cpu
VAE_DEVICE=cuda
# 双卡/多卡加速 (Kaggle GPU T4 x2 自动识别): auto | 1 | 2
GPUS=auto
# 多卡并行模式: auto (双卡默认ddp) | none | ddp | pipeline
PARALLEL_MODE=auto
# 单卡 Token 打包上限覆盖 (0=自动; 双卡 T4 DDP 下默认 9216 可装 2x1024px/卡)
MAX_TOKENS=0

# 断点续炼与权重持久化控制
# 可选值: fresh | resume | init_from
TRAIN_MODE=fresh
RESUME_FROM=latest
INIT_FROM=
SAVE_EVERY=100

# 云端数据源路径、外部多镜像直拉 (支持 | 分隔)、Hugging Face 仓库直拉、超时存盘与压缩包直链
DATASET_DIR=
# 支持单个直链或以 | 分隔的多镜像列表；兼容 temp.sh / filebin.net / transfer.whalebone.io / trystocare / tmpfiles / Cloudflare R2
DATASET_URL=
HF_DATASET_REPO=
HF_DATASET_SUBDIR=
HF_DATASET_REVISION=main
# 超时前自动存盘退出保护 (分钟；0=关闭，默认 540 分钟赶在 Kaggle 12h 硬超时前存盘)
MAX_RUN_MINUTES=540
