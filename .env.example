# ==============================================================================
# OpenMOSS MOSS-Image Dual-Track LoRA Pipeline - 环境变量参考模板 (脱敏)
# ==============================================================================
# 说明：
#   1. 本文件仅作参考与按需导出使用；严禁将包含真实密钥或私有路径的 .env 提交到仓库。
#   2. 本地训练参数也可直接通过 GUI (MOSS_LoRA_Trainer.exe) 或 train_local.py CLI 传递；
#      云端脚本 train_moss.py 支持通过以下环境变量或 CLI 参数控制。

# ------------------------------------------------------------------------------
# 一、Windows 本地运行环境指针 (可选，不配置时会自动全盘探测)
# ------------------------------------------------------------------------------
# 显式指定具备 CUDA PyTorch 的 ComfyUI 便携版 / 独立 Python 路径
# COMFYUI_PYTHON=D:\ComfyUI_windows_portable\python_embeded\python.exe

# 显式指定本地 ComfyUI 安装根目录或 models 目录（也支持 COMFY_PATH / COMFYUI_MODELS）
# COMFYUI_PATH=D:\ComfyUI_windows_portable\ComfyUI
# COMFYUI_MODELS=D:\ComfyUI_windows_portable\ComfyUI\models

# 内部暂停信号文件路径（通常由 gui_local.py 自动生成与清理，一般无需手动设置）
# KOHAKUMOSS_PAUSE_FILE=

# ------------------------------------------------------------------------------
# 二、HuggingFace / GitHub 访问令牌 (可选)
# ------------------------------------------------------------------------------
# 若需在受限网络或云端加速拉取底模，可填入只读 HF Token（切勿提交真实令牌）
# HF_TOKEN=

# ------------------------------------------------------------------------------
# 三、云端引擎 (train_moss.py) 全量可配置环境变量 (与 CLI 参数 1:1 等价)
# ------------------------------------------------------------------------------
# 基础标识与触发词
LORA_NAME=my_lora
TRIGGER_WORD=

# 步数与样本重复配置
REPEATS=10
EPOCHS=6
STEPS=600

# 适配器结构与高阶参数
RANK=32
ALPHA=32.0
# 可选值: lora | loha | lokr
ALGO=lora
# 可选值: false | true
USE_DORA=false
# 可选值: attn | attn-mlp | attn-mlp+modulation | attn-mlp+text-refiner | full-block | all
TARGET_PRESET=attn-mlp
# LoRA+ 上投影学习率倍率 (1.0=关闭, 多概念推荐 2.0~4.0)
LORAPLUS_RATIO=1.0
# 多子集配比 JSON 文件路径或 JSON 数组字符串 (留空则使用单图集)
SUBSETS_JSON=
LR=1e-4

# 底模变体与硬件自适应配置
# 可选值: heal | base | sft (对应参数 --variant)
MODEL_VARIANT=heal
# 可选值: auto | 6g | 8g | 12g | 16g
VRAM_PRESET=auto
# 可选值: 1024 | 768 | 512
RESOLUTION=1024
# 可选值: auto | int8 | full
BASE_QUANT=auto
# 可选值: auto | fp16 | bf16
PRECISION=auto
# 可选值: auto | cuda | cpu
TEXT_DEVICE=auto
# 可选值: cuda | cpu
VAE_DEVICE=cuda

# 断点续炼与权重持久化控制
# 可选值: fresh | resume | init_from
TRAIN_MODE=fresh
RESUME_FROM=latest
INIT_FROM=
SAVE_EVERY=100

# 云端数据源路径或压缩包直链
DATASET_DIR=
DATASET_URL=
